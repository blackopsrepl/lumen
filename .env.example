# Lumen configuration. Copy to .env and edit. Every value is optional.

# --- image -------------------------------------------------------------------
LUMEN_VERSION=0.11.4
PLAYWRIGHT_IMAGE_VERSION=1.63.0
# LUMEN_IMAGE=localhost/lumen:0.11.4
# Container runtime: podman or docker. Auto-detected (podman preferred) when
# unset, so set this only to force one.
# LUMEN_RUNTIME=docker
# Docker elevation: on distros where your user cannot reach the system daemon
# (socket is root:docker and you are in no docker group), Lumen auto-uses
# passwordless `sudo docker`. Set LUMEN_DOCKER_SUDO=1 to allow a sudo password
# prompt instead, =0 to never use sudo (join the docker group or set
# DOCKER_HOST, e.g. for rootless).
# LUMEN_DOCKER_SUDO=auto

# --- service -----------------------------------------------------------------
LUMEN_CONTAINER=lumen
LUMEN_PORT=8899
# Read-only host root exposed at the same absolute path inside the service so
# --quickshell can use host QML files and their sibling imports/assets.
LUMEN_QUICKSHELL_ROOT=/srv/lab/tools
# LUMEN_CHROME=/usr/bin/chromium
# LUMEN_SWAY=/usr/bin/sway
# LUMEN_QUICKSHELL=/usr/bin/quickshell
# LUMEN_WTYPE=/usr/bin/wtype
# LUMEN_LOG sets the container's RUST_LOG. A globally exported RUST_LOG is
# deliberately ignored so your shell cannot change the service's verbosity.
LUMEN_LOG=lumen=info
TZ=UTC

# --- host CLI + skill --------------------------------------------------------
# CLI_VERSION is pinned in install-host.sh; override only to test another one.
# CLI_VERSION=0.1.19
# NPM_PREFIX=/home/pvd/.local
# PW_WORKSPACE=/home/pvd/tools/lumen/.workspace
# AGENT_NAME=default

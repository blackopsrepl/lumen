# Playwright browser stack configuration (architecture B).
#
# Copy to .env and edit. Every value is optional; defaults match the image built
# by bin/build.sh. Comments sit on their own lines so the file parses the same
# way for the bin/*.sh scripts and for `podman compose`.

# --- version pin -------------------------------------------------------------
PLAYWRIGHT_IMAGE_VERSION=1.63.0
# BROWSER_IMAGE=localhost/playwright-browser:1.63.0

# --- browser broker (container) ----------------------------------------------
BROKER_CONTAINER_NAME=browser-broker
BROKER_HOST=127.0.0.1
BROKER_PORT=8090
AGENT_DATA_DIR=/data/agents
MAX_AGENTS=8
AGENT_HEADLESS=1
# Chromium sandbox off; required in most rootless containers.
AGENT_NO_SANDBOX=1
# Extra Chromium flags for every agent browser, word-split.
# AGENT_EXTRA_ARGS=
# Live action callouts + moving pointer in the dashboard (viewer-only).
AGENT_ACTION_ANNOTATIONS=1
AGENT_ACTION_ANNOTATION_MS=1200

# --- agent CLI + dashboard (host) --------------------------------------------
# The CLI runs where the agent runs and attaches to the container over CDP.
# PW_CLI=playwright-cli
# CLI_VERSION=latest
# PW_WORKSPACE=/home/pvd/tools/playwright/.workspace
# Default session name when bin/session.sh is called without an argument.
# AGENT_NAME=default

# Dashboard binds to DASHBOARD_HOST (keep it loopback-only).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8899

# --- human feedback channel (host) -------------------------------------------
# Where the browser saves dashboard annotation exports, and where the watcher
# files them for each agent session.
# DOWNLOADS_DIR=/home/pvd/Downloads
# PW_FEEDBACK_DIR=/home/pvd/tools/playwright/.workspace/feedback
# FEEDBACK_POLL_SECONDS=3

TZ=UTC

# Lumen configuration. Copy to .env and edit. Every value is optional.

# --- image -------------------------------------------------------------------
LUMEN_VERSION=0.1.0
PLAYWRIGHT_IMAGE_VERSION=1.63.0
# LUMEN_IMAGE=localhost/lumen:0.1.0

# --- service -----------------------------------------------------------------
# LUMEN_CONTAINER=lumen
# LUMEN_PORT=8899
RUST_LOG=lumen=info
TZ=UTC


[Unit]
Description=Lumen session daemon
Documentation=man:lumen(1)
# Started with the user session and kept out of the way of it: the compositor
# socket has to exist for any session to be hosted.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/lumen-daemon
Restart=on-failure
RestartSec=2
# The daemon owns its own Wayland socket and a profile tree, so it must not be
# torn down by a session bus that is going away. It is stopped by systemctl.
Slice=background.slice

[Install]
WantedBy=default.target

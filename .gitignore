# Build output
/target/

# CMake build trees. These are generated and enormous; committing them would
# also feed CMakeCache.txt to the secret scanner, which reads its package
# version strings as keys.
/build/
/build-qt/

# Runtime state, never committed.
/runtime/
/data/
/.workspace/
/node_modules/
/test-results/
/playwright-report/
.env
*.log

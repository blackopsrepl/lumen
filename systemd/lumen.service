[Unit]
Description=Lumen session service (__RUNTIME__ Compose)
Documentation=file://__PROJECT_DIR__/README.md
__UNIT_WANTS__
__UNIT_AFTER__

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__PROJECT_DIR__
ExecStart=__COMPOSE__ -f __PROJECT_DIR__/compose.yaml up -d lumen
ExecStop=__COMPOSE__ -f __PROJECT_DIR__/compose.yaml stop lumen
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=default.target
